# Canonical origin, used for metadataBase, OG tags and the canonical link.
# Vercel: set this per environment in Project Settings -> Environment Variables.
NEXT_PUBLIC_SITE_URL=https://alignedwithin.com

# --- Consultation form -------------------------------------------------------
# Resend API key. Without it the form refuses to submit and shows an error
# rather than a false success. https://resend.com/api-keys
RESEND_API_KEY=

# Where consultation requests are delivered.
CONTACT_TO_EMAIL=Drelliewheeler@gmail.com

# Must be an address on a domain verified in Resend. Until alignedwithin.com is
# verified there, Resend's shared sender works for testing:
#   Aligned Within <onboarding@resend.dev>
CONTACT_FROM_EMAIL=Aligned Within <hello@alignedwithin.com>
